    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "jiti": "2.7.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.1",
